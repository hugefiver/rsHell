{
  "version": 1,
  "run_nonce": "static-fixture-contract",
  "actions": [
    { "action": "wait_window_realized" },
    { "action": "new_tab" },
    { "action": "open_connection_editor" },
    { "action": "set_connection_field", "field": { "kind": "text", "field": "name", "value": "P0 QA profile" } },
    { "action": "set_connection_field", "field": { "kind": "port", "port": 22 } },
    { "action": "set_connection_field", "field": { "kind": "transport", "transport": "native_ssh" } },
    { "action": "set_connection_field", "field": { "kind": "authentication", "authentication": "password" } },
    { "action": "set_connection_field", "field": { "kind": "secret_from_env", "env_var": "RSHELL_P0_SECRET" } },
    { "action": "submit_connection" },
    { "action": "select_connection", "connection": "P0 QA profile" },
    { "action": "connect" },
    { "action": "respond_host_key", "accept": true },
    { "action": "respond_auth", "prompt": 0, "env_var": "RSHELL_P0_SECRET" },
    { "action": "send_terminal_text", "text": "printf p0-wide-界" },
    { "action": "paste_text_from_env", "env_var": "RSHELL_P0_PASTE", "effect_marker": "static-paste-effect" },
    { "action": "resize_terminal", "width": 960, "height": 640, "scale": 1.0 },
    { "action": "wait_frame_contains", "text": "p0-wide-界" },
    { "action": "split_horizontal" },
    { "action": "split_vertical" },
    { "action": "switch_tab", "tab": 0 },
    { "action": "search_terminal", "text": "wide", "case_sensitive": false, "regex": false },
    { "action": "select_range", "start_x": 0.0, "start_y": 0.0, "end_x": 12.0, "end_y": 18.0, "rectangular": false },
    { "action": "copy_selection" },
    { "action": "reconnect" },
    { "action": "visual_checkpoint", "surface": "gtk" },
    { "action": "preview_import", "source": "legacy_rshell_json", "path": "tests/fixtures/smoke/legacy.json" },
    { "action": "commit_import" },
    { "action": "cancel_import" },
    { "action": "close_all" }
  ]
}
